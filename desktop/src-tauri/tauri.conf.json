{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidewinder Flow Studio",
  "version": "1.32.0",
  "identifier": "dev.sidewinderlabs.flowstudio",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sidewinder Flow Studio",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/sfs-backend/": "sfs-backend/"
    },
    "category": "Education",
    "shortDescription": "Visual Python data flows",
    "longDescription": "Sidewinder Flow Studio: a visual tool where every node is a Python or SQL cell. Desktop edition with local data.",
    "publisher": "Sidewinder Labs",
    "homepage": "https://sidewinderlabs.dev",
    "license": "AGPL-3.0-or-later"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QzlDRTlBOTM1OTVGNkMKUldSc1gxbVRtczdKbHBKREpOYlI4bWlzczNUZVFyOTZhcGpUNXd5WitwS2MwbUhiUTh4Zm5CTTYK",
      "endpoints": [
        "https://github.com/sidewinder-labs/sidewinder-flow-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
