# Copy this to .env and fill in values before running docker-compose

# Required: generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME_generate_with_fernet_command_above

# Port the UI is available on (default: 8080)
FRONTEND_PORT=8080

# Optional pip extras baked into the backend image (default: all-connectors,pushdown).
# Narrow it for a smaller image, e.g. SFS_EXTRAS=trino,pushdown — any extras from
# backend/pyproject.toml, comma-separated. Set it empty (SFS_EXTRAS=) for core engines only.
# Takes effect on the next image build (docker compose build / up --build).
# SFS_EXTRAS=all-connectors,pushdown
